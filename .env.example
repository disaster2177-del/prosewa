# Copy this file to `.env` and fill in the value.
#
# URL that receives consultation form submissions as a JSON POST.
# Works with Formspree (https://formspree.io/f/xxxxxx), Getform, Basin,
# or your own backend API endpoint.
# If left empty, the form validates input but tells visitors that online
# submission is not yet available and shows call/email options instead.
VITE_FORM_ENDPOINT=
